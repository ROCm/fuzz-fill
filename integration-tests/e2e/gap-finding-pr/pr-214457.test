# REQUIRES: e2e, e2e-bootstrap, gh-token
# COM: End-to-end PR gap finding for llvm/llvm-project#214457.
# COM: Clones llvm-project, builds SanitizerCoverage, runs the full amdgpu
# COM: baseline slice, and checks that the PR's added line in SIFoldOperands.cpp
# COM: is reported as uncovered.

# RUN: rm -rf %t && mkdir -p %t
# RUN: %repo-root/scripts/prepare-pr-llvm.sh --pr-id 214457 --dest %t/llvm-project --plain-clone --squash-commit-file %t/squash-commit
# RUN: test -x %t/build-sancov/bin/llvm-lit || %repo-root/scripts/build-llvm-sancov.sh %repo-root/scripts/allowlist-amdgpu.txt %t/llvm-project %t/build-sancov --bootstrap-bin %e2e-bootstrap-bin --ignorelist %repo-root/scripts/ignorelist-amdgpu.txt
# RUN: %repo-root/scripts/gap-finding-pr.sh --output-dir %t/out --llvm-repo %t/llvm-project --llvm-bin %t/build-sancov/bin --instrumented-bin-dir %t/build-sancov/bin --commit $(cat %t/squash-commit) --backend-tests amdgpu
# RUN: %repo-root/scripts/gap-finding-baseline.sh --output-dir %t/out-direct --llvm-repo %t/llvm-project --llvm-bin %t/build-sancov/bin --instrumented-bin-dir %t/build-sancov/bin --backend-tests amdgpu

# RUN: test -f %t/out/baseline/line_coverage_uncovered.csv
# RUN: test -f %t/out/added-lines/added-lines.csv
# RUN: test -f %t/out/commit_lines_report/target_lines_uncovered.csv

# COM: PR and standalone baseline must produce identical line-level coverage.
# COM: We diff only line_coverage_*.csv, not address_line_map / line_point_summary
# COM: artifacts. Two separate LIT runs can disagree on per-point hits for header
# COM: inlines (e.g. llvm/ADT/DenseMap.h, DenseSet.h, libstdc++ stl_algo.h): the
# COM: same source line can show different hit bits or llc/opt point groupings (~14
# COM: differing rows across the four point-level CSVs: 4 in llc/opt address_line_map,
# COM: 4 in llc_line_point_summary, 2 in opt_line_point_summary).
# COM: This is a very tiny fraction of the point ids. One way to explain this could be rare non-determinisim in the basic block ordering execution.
# COM: The diffs below exclude all .h paths for that reason.
# RUN: bash -c 'filter(){ grep -vE "\.h," "$1"; }; diff <(filter %t/out/baseline/line_coverage_summary.csv) <(filter %t/out-direct/baseline/line_coverage_summary.csv)'
# RUN: bash -c 'filter(){ grep -vE "\.h," "$1"; }; diff <(filter %t/out/baseline/line_coverage_covered.csv) <(filter %t/out-direct/baseline/line_coverage_covered.csv)'
# RUN: bash -c 'filter(){ grep -vE "\.h," "$1"; }; diff <(filter %t/out/baseline/line_coverage_partially.csv) <(filter %t/out-direct/baseline/line_coverage_partially.csv)'
# RUN: bash -c 'filter(){ grep -vE "\.h," "$1"; }; diff <(filter %t/out/baseline/line_coverage_uncovered.csv) <(filter %t/out-direct/baseline/line_coverage_uncovered.csv)'

# COM: SIISelLowering.cpp:1783 must be reported covered.
# RUN: %FileCheck %s --input-file=%t/out/baseline/line_coverage_covered.csv --check-prefix=COVERED
# COVERED: {{.*}}SIISelLowering.cpp,1783{{$}}

# COM: PR #214457 changes SIFoldOperands.cpp line 1712 (Src0Idx -> Src1Idx).
# RUN: %FileCheck %s --input-file=%t/out/added-lines/added-lines.csv --check-prefix=ADDED
# ADDED: path,line_no,text
# ADDED: llvm/lib/Target/AMDGPU/SIFoldOperands.cpp,1712,

# COM: The changed line must appear in the uncovered PR target lines report.
# RUN: %FileCheck %s --input-file=%t/out/commit_lines_report/target_lines_uncovered.csv --check-prefix=TARGET
# TARGET: file,line,text
# TARGET: {{.*}}SIFoldOperands.cpp,1712,

# COM: Gap filling (baseline gaps): pinned candidate from integration-tests/e2e/fixtures/.
# COM: Recalibrate GAP_FILL_* FileCheck lines if the fixture .bc or amdgpu baseline changes:
# COM: run gap-filling.sh against this test's gap-finding artifacts and update the prefixes below.
# RUN: %repo-root/scripts/gap-filling.sh --output-dir %t/gap-fill-baseline --line-coverage-uncovered-csv %t/out/baseline/line_coverage_uncovered.csv --llc-address-line-map-csv %t/out/baseline/llc_address_line_map.csv --candidate-tests-dir %S/../fixtures/candidate-tests --settings-csv %S/../fixtures/candidate-test-settings-e2e.csv -n 1 --llvm-repo %t/llvm-project --llvm-bin %t/build-sancov/bin --instrumented-bin-dir %t/build-sancov/bin -j 2
# RUN: test -f %t/gap-fill-baseline/candidate_tests/candidate_test_manifest.csv
# RUN: test -f %t/gap-fill-baseline/incremental/new_coverage.csv
# RUN: %FileCheck %s --input-file=%t/gap-fill-baseline/incremental/new_coverage.csv --check-prefix=GAP_FILL_BASELINE
# GAP_FILL_BASELINE: test_0_0000a5c12a4ab6566d1f8bf7495ff7fa30d9c93f326071d7e75cea0a1172a0c5.bc,{{.*}}/SIInstrInfo.cpp,1984,

# COM: Gap filling (PR gaps): PR-added uncovered lines; fuzz input must not fill SIFoldOperands.cpp:1712.
# RUN: %repo-root/scripts/gap-filling.sh --output-dir %t/gap-fill-pr --line-coverage-uncovered-csv %t/out/commit_lines_report/target_lines_uncovered.csv --llc-address-line-map-csv %t/out/baseline/llc_address_line_map.csv --candidate-tests-dir %S/../fixtures/candidate-tests --settings-csv %S/../fixtures/candidate-test-settings-e2e.csv -n 1 --llvm-repo %t/llvm-project --llvm-bin %t/build-sancov/bin --instrumented-bin-dir %t/build-sancov/bin -j 2
# RUN: test -f %t/gap-fill-pr/incremental/new_coverage.csv
# RUN: %FileCheck %s --input-file=%t/gap-fill-pr/incremental/new_coverage.csv --check-prefix=GAP_FILL_PR_HDR
# GAP_FILL_PR_HDR: test_name,file,line,covered-points
# RUN: %FileCheck %s --input-file=%t/gap-fill-pr/incremental/new_coverage.csv --check-prefix=GAP_FILL_PR_NOT
# GAP_FILL_PR_NOT-NOT: SIFoldOperands.cpp,1712,

# COM: Reduction: full llvm-reduce on the first baseline gap-fill hit; assert reduced.ll
# COM: exists and is smaller than disassembled input.
# RUN: %repo-root/scripts/reduction.sh --gap-fill-dir %t/gap-fill-baseline --candidate-corpus-dir %S/../fixtures/candidate-tests --llvm-repo %t/llvm-project --llvm-bin %t/build-sancov/bin --instrumented-bin-dir %t/build-sancov/bin -n 1 --pipeline llvm_reduce_ir
# RUN: test -f %t/gap-fill-baseline/reduced/t-00001-test_0_0/reduced/reduced.ll
# RUN: bash -c 'd=%t/gap-fill-baseline/reduced/t-00001-test_0_0; bl=$(mktemp); %t/build-sancov/bin/llvm-dis -o "$bl" "$d/test_0_0000a5c12a4ab6566d1f8bf7495ff7fa30d9c93f326071d7e75cea0a1172a0c5.bc"; test $(stat -c%s "$d/reduced/reduced.ll") -lt $(stat -c%s "$bl"); rm -f "$bl"'

# COM: Drop the llvm-project clone and sancov build after coverage runs to save disk space.
# COM: Delete at the end so it is deleted only on success.
# RUN: rm -rf %t/llvm-project %t/build-sancov %t/build-sancov-helpers
