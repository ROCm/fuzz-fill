# COM: ``coverage baseline`` must fail when the lit filter matches no tests
# COM: (--require-profiles, the default). check-all may still emit incidental
# COM: .profraw from non-lit deps; those must not count as a real baseline.

# RUN: rm -rf %t && mkdir -p %t/baseline-fail
# RUN: %not %coverage baseline --output-dir %t/baseline-fail --build-dir %coverage-build --llvm-src %llvm-repo --host-bin %host-bin --filter 'CodeGen/AMDGPU/fuzz-fill-no-tests' --binary %coverage-build/bin/llc -j1 2>&1 | tee %t/fail.log
# RUN: %FileCheck %s --input-file=%t/fail.log --check-prefix=REQUIRE_ERR
# REQUIRE_ERR: no .profraw files

# COM: ``--no-require-profiles`` allows an empty source baseline.
# RUN: rm -rf %t/baseline-ok && mkdir -p %t/baseline-ok
# RUN: %coverage baseline --output-dir %t/baseline-ok --build-dir %coverage-build --llvm-src %llvm-repo --host-bin %host-bin --filter 'CodeGen/AMDGPU/fuzz-fill-no-tests' --binary %coverage-build/bin/llc --no-require-profiles -j1 2>&1 | tee %t/ok.log
# RUN: test -f %t/baseline-ok/line_coverage_summary.csv
# RUN: test -f %t/baseline-ok/line_coverage_covered.csv
# RUN: test ! -f %t/baseline-ok/line_coverage_partially.csv
# RUN: test -f %t/baseline-ok/line_coverage_uncovered.csv
# RUN: %FileCheck %s --input-file=%t/baseline-ok/line_coverage_summary.csv --check-prefix=EMPTY
# EMPTY: file,line,coverage
# EMPTY-NOT: {{.}}
