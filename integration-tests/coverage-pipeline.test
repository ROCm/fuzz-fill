# RUN: bash -c 'd=$(echo %t/gap-fill/reduced/t-00001-*); test -f "$d/reduced/reduced.ll"'
# RUN: bash -c 'd=$(echo %t/gap-fill/reduced/t-00001-*); input=$(ls "$d"/*.ll "$d"/*.bc 2>/dev/null | head -1); reduced="$d/reduced/reduced.ll"; bl=$(mktemp); %llvm-dis -o "$bl" "$input"; test $(stat -c%s "$reduced") -lt $(stat -c%s "$bl"); rm -f "$bl"'
# RUN: bash -c 'd=$(echo %t/gap-fill/reduced/t-00001-*); "$d/interesting_ir.sh" "$d/reduced/reduced.ll"' 2>&1 | %FileCheck %s --check-prefix=REDUCED_COVERAGE
# REDUCED_COVERAGE: COVERED (0x{{[0-9a-fA-F]+}}) is present in sancov --print output
