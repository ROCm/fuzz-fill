# COM: baseline and incremental env fallbacks: omit per-tool flags when
# COM: FUZZ_FILL_SANCOV / FUZZ_FILL_LLVM_LIT / FUZZ_FILL_LLC / FUZZ_FILL_OPT are set on the RUN line.
# COM: candidate-test prerequisite uses explicit flags (not under test here).

# RUN: rm -rf %t && mkdir -p %t/{baseline,candidate,incremental}
# RUN: env FUZZ_FILL_SANCOV=%sancov FUZZ_FILL_LLVM_LIT=%llvm-lit FUZZ_FILL_LLC=%sancov-llc FUZZ_FILL_OPT=%sancov-opt %coverage baseline --output-dir %t/baseline --lit-filter CodeGen/AMDGPU/loop-live-out-copy-undef-subrange.ll -j1
# RUN: test -f %t/baseline/line_coverage_summary.csv
# RUN: test -f %t/baseline/line_coverage_covered.csv
# RUN: test -f %t/baseline/line_coverage_partially.csv
# RUN: test -f %t/baseline/line_coverage_uncovered.csv
# RUN: %coverage candidate-test --output-dir %t/candidate --llc %sancov-llc --candidate-tests-dir %S/fixtures/coverage-new-tests --n 1
# RUN: env FUZZ_FILL_SANCOV=%sancov %coverage incremental --output-dir %t/incremental --line-coverage-uncovered-csv %t/baseline/line_coverage_uncovered.csv --llc-address-line-map-csv %t/baseline/llc_address_line_map.csv --candidate-tests-output-dir %t/candidate
# RUN: test -f %t/incremental/new_coverage.csv
