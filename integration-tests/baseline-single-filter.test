# COM: Run `coverage baseline` with a filter that matches exactly one lit test
# COM: and without -j (so no job count is forwarded and llvm-lit picks its own
# COM: default). Validate the baseline coverage artifacts are produced.

# RUN: rm -rf %t && mkdir -p %t/baseline
# RUN: %coverage baseline --output-dir %t/baseline --llvm-bin "$(dirname %FileCheck)" --instrumented-bin "$(dirname %sancov-llc)" --lit-filter 'CodeGen/AMDGPU/loop-live-out-copy-undef-subrange\.ll$'

# COM: A successful single-test suite run must emit the baseline artifacts.
# RUN: test -f %t/baseline/run_config.json
# RUN: test -f %t/baseline/test_coverage.csv
# RUN: test -f %t/baseline/llc_address_line_map.csv

# COM: Verify the test actually executed by confirming non-empty coverage: the
# COM: CSV must contain at least one real data row (an AMDGPU source path with a
# COM: line number and llc point), not just the header.
# RUN: %FileCheck %s --input-file=%t/baseline/test_coverage.csv --check-prefix=COVERAGE
# COVERAGE: file,line,point_llc
# COVERAGE: {{.*}}/AMDGPU/{{.*}}.cpp,{{[0-9]+}},0x{{[0-9a-f]+}}
