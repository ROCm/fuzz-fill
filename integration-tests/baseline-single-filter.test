# COM: Run `coverage baseline` with a filter that matches exactly one lit test,
# COM: without -j (llvm-lit picks its own default), and with --lit-verbose and
# COM: --lit-allow-failures. Validate baseline coverage artifacts are produced.

# RUN: rm -rf %t && mkdir -p %t/baseline
# RUN: %coverage baseline --output-dir %t/baseline --llvm-bin "$(dirname %FileCheck)" --instrumented-bin "$(dirname %sancov-llc)" --lit-filter 'CodeGen/AMDGPU/loop-live-out-copy-undef-subrange\.ll$' --lit-verbose --lit-allow-failures | tee %t/baseline.log

# COM: --lit-verbose forwards -vv to llvm-lit; expect per-test PASS output.
# RUN: %FileCheck %s --input-file=%t/baseline.log --check-prefix=VERBOSE
# VERBOSE: PASS:

# COM: --lit-allow-failures must not warn when llvm-lit succeeds.
# RUN: %FileCheck %s --input-file=%t/baseline.log --check-prefix=ALLOW_OK
# ALLOW_OK-NOT: warning: llvm-lit exited with code

# COM: A successful single-test suite run must emit the baseline artifacts.
# RUN: test -f %t/baseline/run_config.json
# RUN: test -f %t/baseline/line_coverage_summary.csv
# RUN: test -f %t/baseline/llc_address_line_map.csv

# COM: Verify the test actually executed by confirming non-empty coverage: the
# COM: address map must contain at least one real data row (an AMDGPU source path with a
# COM: line number and llc point), not just the header.
# RUN: %FileCheck %s --input-file=%t/baseline/llc_address_line_map.csv --check-prefix=COVERAGE
# COVERAGE: file,line,point_llc
# COVERAGE: {{.*}}/AMDGPU/{{.*}}.cpp,{{[0-9]+}},0x{{[0-9a-f]+}}
