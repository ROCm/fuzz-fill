# COM: Source-coverage baseline over a tiny filtered check-all slice.
# COM: The baseline writes only covered/uncovered line splits and relative paths.

# RUN: rm -rf %t && mkdir -p %t/baseline
# RUN: %coverage baseline --output-dir %t/baseline --build-dir %coverage-build --llvm-src %llvm-repo --host-bin %host-bin --filter 'CodeGen/AMDGPU/loop-live-out-copy-undef-subrange\.ll$' --binary %coverage-build/bin/llc -j1 2>&1 | tee %t/baseline.log

# RUN: test -f %t/baseline/line_coverage_summary.csv
# RUN: test -f %t/baseline/line_coverage_covered.csv
# RUN: test ! -f %t/baseline/line_coverage_partially.csv
# RUN: test -f %t/baseline/line_coverage_uncovered.csv
# RUN: test -f %t/baseline/lit_failures.json
# RUN: test -f %t/baseline/check-all.log
# RUN: test -f %t/baseline/coverage.lcov

# RUN: %FileCheck %s --input-file=%t/baseline/lit_failures.json --check-prefix=LIT_FAILURES
# LIT_FAILURES: "tests": []
# LIT_FAILURES-NOT: "code":

# RUN: %FileCheck %s --input-file=%t/baseline/line_coverage_summary.csv --check-prefix=SUMMARY
# SUMMARY: file,line,coverage
# SUMMARY: llvm/lib/Target/AMDGPU/{{.*}}.cpp,{{[0-9]+}},{{covered|uncovered}}

# RUN: %FileCheck %s --input-file=%t/baseline/line_coverage_covered.csv --check-prefix=SPLIT
# RUN: %FileCheck %s --input-file=%t/baseline/line_coverage_uncovered.csv --check-prefix=SPLIT
# SPLIT: file,line
# SPLIT-NOT: {{^}}file,line,coverage
