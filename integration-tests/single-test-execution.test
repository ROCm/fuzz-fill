# COM: Run the coverage pipeline over a single standalone test file and validate
# COM: that every execution succeeded. With --n 1, candidate-test runs the one input
# COM: file once per default settings row (-Ox x -global-isel=0/1), so a fully
# COM: successful run must report all eight executions complete and none skipped.

# RUN: rm -rf %t && mkdir -p %t/candidate_tests
# RUN: %coverage candidate-test --output-dir %t/candidate_tests --llc %sancov-llc --candidate-tests-dir %S/fixtures/coverage-new-tests --n 1 2>&1 | tee %t/candidate_tests.log

# COM: The final progress line reports the tallies across all eight settings runs.
# RUN: %FileCheck %s --input-file=%t/candidate_tests.log --check-prefix=EXEC
# EXEC: complete=8  skipped=0  remaining=0

# COM: Every settings run must leave its own successful test directory behind (skipped
# COM: runs are torn down), so all eight per-settings output dirs must exist.
# RUN: test -d %t/candidate_tests/test_0_standalone-empty-kernel.ll
# RUN: test -d %t/candidate_tests/test_1_standalone-empty-kernel.ll
# RUN: test -d %t/candidate_tests/test_2_standalone-empty-kernel.ll
# RUN: test -d %t/candidate_tests/test_3_standalone-empty-kernel.ll
# RUN: test -d %t/candidate_tests/test_4_standalone-empty-kernel.ll
# RUN: test -d %t/candidate_tests/test_5_standalone-empty-kernel.ll
# RUN: test -d %t/candidate_tests/test_6_standalone-empty-kernel.ll
# RUN: test -d %t/candidate_tests/test_7_standalone-empty-kernel.ll

# COM: Each successful run must have produced sancov coverage output.
# RUN: ls %t/candidate_tests/test_0_standalone-empty-kernel.ll/*.sancov
# RUN: ls %t/candidate_tests/test_7_standalone-empty-kernel.ll/*.sancov
