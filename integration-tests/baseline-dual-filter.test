# COM: Run `coverage baseline` with two --lit-filter flags that each match exactly
# COM: one lit test. Verify llvm-lit runs both tests (OR'd filter) and baseline
# COM: coverage artifacts are produced.

# RUN: rm -rf %t && mkdir -p %t/baseline
# RUN: %coverage baseline --output-dir %t/baseline --sancov %sancov --llvm-lit %llvm-lit --llc %sancov-llc --opt %sancov-opt --lit-filter CodeGen/AMDGPU/loop-live-out-copy-undef-subrange.ll --lit-filter CodeGen/AMDGPU/loop-idiom.ll --lit-verbose --lit-allow-failures -j1 | tee %t/baseline.log

# COM: --lit-verbose forwards -vv to llvm-lit; expect exactly two PASS lines.
# RUN: %FileCheck %s --input-file=%t/baseline.log --check-prefix=DUAL_PASS
# DUAL_PASS-DAG: loop-live-out-copy-undef-subrange.ll
# DUAL_PASS-DAG: loop-idiom.ll
# DUAL_PASS-NOT: loop_break.ll

# RUN: %FileCheck %s --input-file=%t/baseline.log --check-prefix=PASS_COUNT
# PASS_COUNT-COUNT-2: PASS:

# COM: --lit-allow-failures must not warn when llvm-lit succeeds.
# RUN: %FileCheck %s --input-file=%t/baseline.log --check-prefix=ALLOW_OK
# ALLOW_OK-NOT: warning: llvm-lit exited with code

# COM: A successful dual-test suite run must emit the baseline artifacts.
# RUN: test -f %t/baseline/line_coverage_summary.csv
# RUN: test -f %t/baseline/line_coverage_covered.csv
# RUN: test -f %t/baseline/line_coverage_partially.csv
# RUN: test -f %t/baseline/line_coverage_uncovered.csv
# RUN: test -f %t/baseline/llc_address_line_map.csv
# RUN: test -f %t/baseline/lit_failures.json
# RUN: test -f %t/baseline/llc_line_point_summary.csv
# RUN: test -f %t/baseline/opt_line_point_summary.csv

# COM: lit_failures.json is always written; with no lit failures the tests array is empty.
# RUN: %FileCheck %s --input-file=%t/baseline/lit_failures.json --check-prefix=LIT_FAILURES
# LIT_FAILURES: "__version__":
# LIT_FAILURES: "elapsed":
# LIT_FAILURES: "tests": []
# LIT_FAILURES-NOT: "code":

# COM: Verify the tests actually executed by confirming non-empty coverage: the
# COM: address map must contain at least one real data row (an AMDGPU source path with a
# COM: line number and llc point), not just the header.
# RUN: %FileCheck %s --input-file=%t/baseline/llc_address_line_map.csv --check-prefix=COVERAGE
# COVERAGE: file,line,point
# COVERAGE: {{.*}}/AMDGPU/{{.*}}.cpp,{{[0-9]+}},0x{{[0-9a-f]+}}
