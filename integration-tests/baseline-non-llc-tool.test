# COM: Run `coverage baseline` on a single MC/AMDGPU lit test that invokes
# COM: llvm-mc (not llc/opt). Verify per-tool aggregation writes llvm-mc maps
# COM: and does not invent an llc map for a tool that never ran.

# RUN: rm -rf %t && mkdir -p %t/baseline
# RUN: %coverage baseline --output-dir %t/baseline --sancov %sancov --llvm-lit %llvm-lit --llc %sancov-llc --opt %sancov-opt --tests llvm/test/MC/AMDGPU --lit-filter 'MC/AMDGPU/alignto_mcexpr\.s$' --lit-verbose --lit-allow-failures -j1 | tee %t/baseline.log

# RUN: %FileCheck %s --input-file=%t/baseline.log --check-prefix=PASS
# PASS-COUNT-1: PASS:
# PASS: alignto_mcexpr.s
# PASS-NOT: warning: llvm-lit exited with code

# COM: Shared baseline artifacts.
# RUN: test -f %t/baseline/line_coverage_summary.csv
# RUN: test -f %t/baseline/line_coverage_covered.csv
# RUN: test -f %t/baseline/line_coverage_partially.csv
# RUN: test -f %t/baseline/line_coverage_uncovered.csv
# RUN: test -f %t/baseline/lit_failures.json

# COM: llvm-mc emitted coverage; llc did not run.
# RUN: test -f %t/baseline/llvm-mc_address_line_map.csv
# RUN: test -f %t/baseline/llvm-mc_line_point_summary.csv
# RUN: test ! -f %t/baseline/llc_address_line_map.csv
# RUN: test ! -f %t/baseline/opt_address_line_map.csv
# RUN: ls %t/baseline/raw_sancov/llvm-mc.*.sancov
# RUN: test -f %t/baseline/processed_sancov/llvm-mc.0.sancov
# RUN: test -f %t/baseline/processed_sancov/llvm-mc.0.symcov

# COM: Address map has at least one real instrumentation point, and the joint
# COM: summary marks at least one line covered or partially covered.
# RUN: %FileCheck %s --input-file=%t/baseline/llvm-mc_address_line_map.csv --check-prefix=COVERAGE
# COVERAGE: file,line,point
# COVERAGE: {{.*}},{{[0-9]+}},0x{{[0-9a-f]+}}
# RUN: %FileCheck %s --input-file=%t/baseline/line_coverage_summary.csv --check-prefix=HIT
# HIT: {{.*,(covered|partially)$}}
